rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para chequear autenticación
    function isAuth() {
      return request.auth != null;
    }
    
    // Función auxiliar para el Super Administrador
    function isAdmin() {
      return isAuth() && request.auth.token.email == "jd.rincon021@gmail.com";
    }
    
    // Función auxiliar para chequear propiedad
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Colecciones raíz protegidas (solo lectura o gestionadas por el backend)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /subscriptions/{userId} {
      // El backend escribe las suscripciones, el cliente solo lee la suya
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin(); 
    }
    
    match /payments/{paymentId} {
      // El usuario puede leer los suyos
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
      // Permite crear pagos si los asigna a sí mismo
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin(); // Solo el admin actualiza estado
    }

    // Subcolecciones del usuario (Negocios, Clientes, Presupuestos)
    match /users/{userId}/businesses/{businessId} {
      allow read, write: if isOwner(userId);
      
      match /clients/{clientId} {
        allow read, write: if isOwner(userId);
      }
      
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
      
      match /catalogItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
      
      match /quotes/{quoteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Presupuestos compartidos (Lectura pública)
    // Cuando el usuario le da a "Compartir", se hace una copia en esta colección.
    match /publicQuotes/{quoteId} {
      allow read: if true;
      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
